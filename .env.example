# STT
assemblyai_api_key = 'Assembly_AI_api_key' 

# TTS
elevenlab_Api_key = 'elevenlab_api_key'
elevenlab_voice_id = 'elevenlab_voice_id'

# LLM + STT (Whisper) + TTS (PlayAI) - all use same key
GROQ_API_KEY = "GROQ_API_KEY"

# Supabase (Vector Store + Storage)
SUPABASE_URL = "https://xxxxx.supabase.co"
SUPABASE_SERVICE_KEY = "your-service-role-key-here"  # Use service key for server-side apps
SUPABASE_API_KEY = "your-anon-key-here"  # Alternative: use anon key with RLS policies

# Supabase Storage - Dynamic bucket name
# Set this to your organization/product name
# Default: 'user-files' if not set
SUPABASE_BUCKET = "Organisation name"

# Vapi (Voice AI)
VAPI_API_TOKEN = "your-vapi-api-token-here"